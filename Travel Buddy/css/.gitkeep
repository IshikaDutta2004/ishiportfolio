/* =====================================================
                TRAVEL BUDDY
                STYLE.CSS
===================================================== */

/* Google Font */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

/*=====================
        RESET
======================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    background:#F8F9FC;

    color:#1E293B;

    font-family:'Poppins',sans-serif;

}

img{
    width:100%;
    display:block;
}

a{
    text-decoration:none;
}

ul{
    list-style:none;
}

/*=====================
        VARIABLES
======================*/

:root{

    --primary:#4F46E5;

   --secondary:#7C3AED;

    --accent:#F59E0B;

    --white:#ffffff;

   --dark:#0F172A;

   --text:#475569;

   --background:#F8F9FC;

}

/*=====================
        HEADER
======================*/

.header{

    position:fixed;

    top:0;

    left:0;

    width:100%;

    z-index:999;

    background:rgba(248,249,252,.96);

    backdrop-filter:blur(18px);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.navbar{

    width:90%;

    margin:auto;

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:18px 0;

}

.logo{

    display:flex;

    align-items:center;

    gap:10px;

    font-size:28px;

    color:#1E293B;

    font-weight:700;

}

.logo i{

    font-size:38px;

    color:var(--primary);

    margin-right:10px;

    transform:rotate(-15deg);

}

.nav-menu{

    display:flex;

    gap:35px;

}

.nav-menu a{

    color:var(--dark);

    font-weight:500;

    transition:.3s;

}

.nav-menu a:hover{

    color:var(--primary);

}

.nav-buttons{

    display:flex;

    gap:15px;

}

.login-btn{

    padding:12px 22px;

    color:var(--primary);

    font-weight:600;

}

.book-btn{

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:white;

    padding:12px 25px;

    border-radius:40px;

    transition:.3s;

}

.book-btn:hover{

    transform:translateY(-3px);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.menu-toggle{

    display:none;

    font-size:28px;

    cursor:pointer;

}

/*=====================
        HERO
======================*/

.hero{

    width:90%;

    margin:auto;

    min-height:100vh;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:60px;

    padding-top:100px;

}

.hero-content{

    flex:1;

}

.hero-tag{

    background:#EDE9FE;

    color:var(--primary);

    padding:8px 18px;

    border-radius:50px;

    display:inline-block;

    margin-bottom:25px;

    font-weight:600;

}

.hero-content h1{

    font-size:60px;

    line-height:1.2;

    margin-bottom:25px;

}

.hero-content h1 span{

    color:#0F172A;

}

.hero-content p{

    color:#0F172A;

    line-height:1.8;

    font-size:18px;

    margin-bottom:35px;

}

.hero-buttons{

    display:flex;

    gap:20px;

    margin-bottom:50px;

}

.primary-btn{

    padding:15px 30px;

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:white;

    border-radius:40px;

    transition:.3s;

}

.secondary-btn{

    padding:15px 30px;

    border:2px solid var(--primary);

    color:var(--primary);

    border-radius:40px;

    transition:.3s;

}

.primary-btn,
.secondary-btn{

    transition:.35s;

}

.primary-btn:hover,
.secondary-btn:hover{

    transform:translateY(-5px);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.hero-image{

    flex:1;

}

.hero-image img{

    max-width:550px;

    margin:auto;

}

/*=====================
        STATS
======================*/

.hero-stats{

    display:flex;

    gap:30px;

}

.stat-box{

    background:white;

    padding:20px;

    border-radius:20px;

    text-align:center;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.stat-box h3{

    color:var(--primary);

    font-size:30px;

}

.stat-box p{

    margin-top:8px;

    color:var(--text);

    font-size:15px;

}

/*=====================
        SEARCH
======================*/

.search-section{

    width:90%;

    margin:70px auto;

}

.search-container{

    background:#ffffff;

    padding:25px;

    border-radius:25px;

    display:grid;

    grid-template-columns:repeat(5,1fr);

    gap:20px;

   box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.search-box{

    display:flex;

    flex-direction:column;

}

.search-box label{

    font-weight:600;

    margin-bottom:10px;

}

.search-box input,

.search-box select{

    padding:12px;

    border:1px solid #ddd;

    border-radius:12px;

    outline:none;

}

.search-btn{

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:white;

    border:none;

    border-radius:15px;

    cursor:pointer;

    font-size:17px;

}
/*=====================================
        SERVICES
=====================================*/

.services{

    width:90%;

    margin:100px auto;

}

.section-title{

    text-align:center;

    margin-bottom:60px;

}

.section-title span{

    color:var(--primary);

    font-weight:600;

    background:#EEF2FF;

    padding:8px 18px;

    border-radius:30px;

}

.section-title h2{

    font-size:42px;

    margin:20px 0;

}

.section-title p{

    color:var(--text);

    max-width:650px;

    margin:auto;

    line-height:1.8;

}

.services-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:30px;

}

.service-card{

    background:#fff;

    border-radius:20px;

    overflow:hidden;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

    transition:.4s;

}

.service-card:hover{

    transform:translateY(-12px) scale(1.02);

}

.service-card img{

    height:220px;

    object-fit:cover;

}

.service-content{

    padding:25px;

}

.service-content i{

    font-size:30px;

    color:var(--primary);

    margin-bottom:15px;

}

.service-content h3{

    margin-bottom:15px;

}

.service-content p{

    color:var(--text);

    line-height:1.7;

    margin-bottom:25px;

}

.service-btn{

    display:inline-block;

    padding:12px 24px;

    border-radius:30px;

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:#fff;

    transition:.3s;

}

.service-btn:hover{

    transform:translateY(-3px);

}
/*=====================================
      DESTINATIONS
=====================================*/

.destinations{

    width:90%;

    margin:120px auto 80px;

}

.destination-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));

    gap:40px;

}

.destination-card{

    background:#fff;

    border-radius:20px;

    overflow:hidden;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

    transition:.4s;

}

.destination-card:hover{

 transform:translateY(-12px) scale(1.02);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.destination-card img{

    width:100%;

    height:230px;

    object-fit:cover;

}

.destination-content{

    padding:30px;

}

.destination-content h3{

    font-size:24px;

    margin-bottom:12px;

    color:var(--dark);

}

.destination-content p{

    color:var(--text);

    line-height:1.7;

    margin-bottom:20px;

}

.destination-footer{

    display:flex;

    justify-content:space-between;

    align-items:center;

    font-weight:600;

    color:var(--primary);

}
/*=====================================
        FEATURES
=====================================*/

.features{

    width:90%;

    margin:120px auto;

}

.features-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:30px;

}

.feature-card{

    background:#ffffff;

    padding:35px 30px;

    border-radius:20px;

    text-align:center;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

    transition:.4s;

}

.feature-card:hover{

   transform:translateY(-12px) scale(1.02);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.feature-icon{

    width:80px;

    height:80px;

    margin:auto;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:#fff;

    font-size:32px;

    margin-bottom:25px;

}

.feature-card h3{

    margin-bottom:15px;

    font-size:24px;

}

.feature-card p{

    color:var(--text);

    line-height:1.8;

}
/*=====================================
        TESTIMONIALS
=====================================*/

.testimonials{

    width:90%;

    margin:120px auto;

}

.testimonial-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));

    gap:30px;

}

.testimonial-card{

    background:#ffffff;

    padding:35px;

    border-radius:20px;

    text-align:center;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

    transition:.4s;

}

.testimonial-card:hover{

   transform:translateY(-12px) scale(1.02);

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.testimonial-card img{

    width:100px;

    height:100px;

    border-radius:50%;

    object-fit:cover;

    margin:0 auto 20px;

    border:4px solid var(--primary);

}

.testimonial-card h3{

    margin-bottom:5px;

    font-size:22px;

}

.testimonial-card span{

    color:var(--text);

    font-size:15px;

}

.stars{

    font-size:20px;

    margin:20px 0;

}

.testimonial-card p{

    color:var(--text);

    line-height:1.8;

    font-style:italic;

}
/*=====================================
            CONTACT
=====================================*/

.contact{

    width:90%;

    margin:120px auto;

}

.contact-container{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:60px;

    align-items:center;

}

.contact-info h3{

    font-size:32px;

    margin-bottom:20px;

}

.contact-info p{

    color:var(--text);

    line-height:1.8;

    margin-bottom:30px;

}

.info-box{

    display:flex;

    align-items:center;

    gap:18px;

    margin-bottom:25px;

    font-size:18px;

}

.info-box i{

    width:50px;

    height:50px;

    border-radius:50%;

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:white;

    display:flex;

    justify-content:center;

    align-items:center;

}

.social-icons{

    display:flex;

    gap:20px;

    margin-top:30px;

}

.social-icons a{

    width:50px;

    height:50px;

    border-radius:50%;

    background:var(--primary);

    color:white;

    display:flex;

    justify-content:center;

    align-items:center;

    transition:.3s;

}

.social-icons a:hover{

    background:var(--secondary);

    transform:translateY(-5px);

}

.contact-form{

    background:white;

    padding:40px;

    border-radius:20px;

    box-shadow:0 12px 35px rgba(15,23,42,.08);

}

.contact-form form{

    display:flex;

    flex-direction:column;

    gap:20px;

}

.contact-form input,

.contact-form textarea{

    padding:16px;

    border:1px solid #ddd;

    border-radius:12px;

    font-size:16px;

    outline:none;

    font-family:'Poppins',sans-serif;

}

.contact-form textarea{

    resize:none;

}

.contact-form button{

    border:none;

    cursor:pointer;

}
/*=====================================
            FOOTER
=====================================*/

.footer{

   background:#0F172A;

    color:white;

    margin-top:120px;

    padding:80px 10% 30px;

}

.footer-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:40px;

}

.footer-box h3{

    margin-bottom:20px;

    color:#fff;

}

.footer-box p{

    color:#CBD5E1;

    line-height:1.8;

}

.footer-box ul{

    list-style:none;

}

.footer-box ul li{

    margin-bottom:12px;

    color:#CBD5E1;

}

.footer-box ul li a{

    color:#CBD5E1;

    transition:.3s;

}

.footer-box ul li a:hover{

    color:#ffffff;

}

.newsletter{

    display:flex;

    margin-top:20px;

}

.newsletter input{

    flex:1;

    padding:12px;

    border:none;

    outline:none;

    border-radius:8px 0 0 8px;

}

.newsletter button{

    border:none;

    background:var(--primary);

    color:white;

    padding:12px 18px;

    border-radius:0 8px 8px 0;

    cursor:pointer;

}

.footer hr{

    margin:50px 0 25px;

    border:.5px solid rgba(255,255,255,.2);

}

.footer-bottom{

    text-align:center;

    color:#CBD5E1;

}

/* Scroll Button */

.scroll-top{

    position:fixed;

    right:35px;

    bottom:35px;

    width:55px;

    height:55px;

    border:none;

    border-radius:50%;

    background:linear-gradient(135deg,var(--primary),var(--secondary));

    color:white;

    font-size:22px;

    cursor:pointer;

    display:none;

}
/*=====================================
        TABLET RESPONSIVE
        (1024px and below)
=====================================*/

@media (max-width:1024px){

    /* Navbar */

    .navbar{

        width:95%;

        padding:18px 0;

    }

    .nav-menu{

        gap:18px;

    }

    /* Hero */

    .hero{

        flex-direction:column;

        text-align:center;

        padding-top:140px;

        gap:50px;

    }

    .hero-content{

        order:2;

    }

    .hero-image{

        order:1;

    }

    .hero-content h1{

        font-size:48px;

    }

    .hero-content p{

        font-size:17px;

    }

    .hero-buttons{

        justify-content:center;

    }

    .hero-stats{

        justify-content:center;

        flex-wrap:wrap;

    }

    /* Search */

    .search-container{

        grid-template-columns:repeat(2,1fr);

    }

    .search-btn{

        grid-column:span 2;

    }

    /* Services */

    .services-container{

        grid-template-columns:repeat(2,1fr);

    }

    /* Destinations */

    .destination-container{

        grid-template-columns:repeat(2,1fr);

    }

    /* Features */

    .features-container{

        grid-template-columns:repeat(2,1fr);

    }

    /* Testimonials */

    .testimonial-container{

        grid-template-columns:repeat(2,1fr);

    }

    /* Contact */

    .contact-container{

        grid-template-columns:1fr;

    }

    /* Footer */

    .footer-container{

        grid-template-columns:repeat(2,1fr);

    }

}
/*=====================================
        MOBILE RESPONSIVE
        (768px and below)
=====================================*/

@media (max-width:768px){

    /* ---------- Navigation ---------- */

    .navbar{

        width:92%;

        padding:18px 0;

    }

    .nav-menu{

        display:none;

    }

    .nav-buttons{

        display:none;

    }

    .menu-toggle{

        display:block;

        font-size:28px;

        color:var(--primary);

    }

    /* ---------- Hero ---------- */

    .hero{

        flex-direction:column;

        text-align:center;

        gap:40px;

        padding-top:120px;

    }

    .hero-content h1{

        font-size:38px;

        line-height:1.3;

    }

    .hero-content p{

        font-size:16px;

    }

    .hero-buttons{

        flex-direction:column;

        align-items:center;

    }

    .primary-btn,

    .secondary-btn{

        width:220px;

        text-align:center;

    }

    .hero-image img{

        max-width:320px;

    }

    .hero-stats{

        flex-direction:column;

        align-items:center;

        gap:20px;

    }

    /* ---------- Search ---------- */

    .search-container{

        grid-template-columns:1fr;

    }

    .search-btn{

        grid-column:span 1;

        padding:15px;

    }

    /* ---------- Section Titles ---------- */

    .section-title h2{

        font-size:32px;

    }

    .section-title p{

        font-size:15px;

    }

    /* ---------- Services ---------- */

    .services-container{

        grid-template-columns:1fr;

    }

    /* ---------- Destinations ---------- */

    .destination-container{

        grid-template-columns:1fr;

    }

    /* ---------- Features ---------- */

    .features-container{

        grid-template-columns:1fr;

    }

    /* ---------- Testimonials ---------- */

    .testimonial-container{

        grid-template-columns:1fr;

    }

    /* ---------- Contact ---------- */

    .contact-container{

        grid-template-columns:1fr;

        gap:40px;

    }

    .contact-form{

        padding:25px;

    }

    /* ---------- Footer ---------- */

    .footer-container{

        grid-template-columns:1fr;

        text-align:center;

    }

    .newsletter{

        flex-direction:column;

        gap:12px;

    }

    .newsletter input{

        border-radius:10px;

    }

    .newsletter button{

        border-radius:10px;

    }

    .social-icons{

        justify-content:center;

    }

}
/*=====================================
        MOBILE MENU
=====================================*/

.menu-toggle{

    display:none;

    cursor:pointer;

    font-size:30px;

}

@media (max-width:768px){

    .menu-toggle{

        display:block;

        z-index:1001;

    }

    .nav-menu{

        position:fixed;

        top:80px;

        right:-100%;

        width:260px;

        height:calc(100vh - 80px);

        background:#ffffff;

        display:flex;

        flex-direction:column;

        align-items:center;

        justify-content:flex-start;

        gap:30px;

        padding-top:40px;

        transition:.4s ease;

        box-shadow:-5px 0 20px rgba(0,0,0,.1);

    }

    .nav-menu.active{

        right:0;

    }

}
/*=====================================
        SCROLL REVEAL ANIMATION
=====================================*/

.reveal{

    opacity:0;

    transform:translateY(70px);

    transition:opacity .8s ease, transform .8s ease;

}

.reveal.active{

    opacity:1;

    transform:translateY(0);

}
/*=====================================
        DARK MODE
=====================================*/

.theme-toggle{

    width:45px;

    height:45px;

    border-radius:50%;

    background:#ffffff;

    display:flex;

    justify-content:center;

    align-items:center;

    cursor:pointer;

    box-shadow:0 8px 20px rgba(0,0,0,.12);

    transition:.3s;

    font-size:20px;

    color:var(--primary);

}

.theme-toggle:hover{

    transform:rotate(20deg);

}

/* Dark Theme */

body.dark{

    background:#0f172a;

    color:#ffffff;

}

body.dark section{

    background:#0f172a;

}

body.dark .service-card,

body.dark .destination-card,

body.dark .feature-card,

body.dark .testimonial-card,

body.dark .contact-form{

    background:#1e293b;

    color:#ffffff;

}

body.dark p,

body.dark span,

body.dark li{

    color:#d1d5db;

}

body.dark h1,

body.dark h2,

body.dark h3{

    color:#ffffff;

}

body.dark .navbar{

    background:#111827;

}

body.dark .footer{

    background:#020617;
}
/* ==============================
            PRELOADER
================================= */

#preloader{

    position: fixed;

    top: 0;

    left: 0;

    width: 100%;

    height: 100vh;

    background: #ffffff;

    display: flex;

    justify-content: center;

    align-items: center;

    z-index: 99999;

    transition: opacity .5s ease;

}

.loader{

    width: 70px;

    height: 70px;

    border: 6px solid #e5e7eb;

    border-top: 6px solid var(--primary);

    border-radius: 50%;

    animation: spin 1s linear infinite;

}

@keyframes spin{

    from{

        transform: rotate(0deg);

    }

    to{

        transform: rotate(360deg);

    }

}
/*=====================================
        CUSTOM SCROLLBAR
=====================================*/

::-webkit-scrollbar{

    width:10px;

}

::-webkit-scrollbar-track{

    background:#f5f5f5;

}

::-webkit-scrollbar-thumb{

    background:linear-gradient(
        var(--primary),
        var(--secondary)
    );

    border-radius:20px;

}

::-webkit-scrollbar-thumb:hover{

    background:var(--primary);

}
/*=====================================
        TEXT SELECTION
=====================================*/

::selection{

    background:var(--primary);

    color:#fff;

}
.header.sticky{

    padding:0;

    background:rgba(248,249,252,.98);

    backdrop-filter:blur(20px);

    box-shadow:0 8px 25px rgba(15,23,42,.10);

}
